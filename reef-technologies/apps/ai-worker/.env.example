ENVIRONMENT=development
LOG_LEVEL=debug
PORT=8000

# Must match apps/api — both services share the database and the streams.
DATABASE_URL=postgres://reef_technologies:reef_technologies@localhost:5432/reef_technologies
REDIS_URL=redis://localhost:6379
EVENT_STREAM_PREFIX=reef_technologies:events
# A DIFFERENT group from the API's, so both receive every event.
EVENT_CONSUMER_GROUP=reef-technologies-ai-worker

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REASONING_MODEL=claude-opus-5
FAST_MODEL=claude-haiku-4-5-20251001

# Credentials decide which providers run. There is no PROVIDER= switch to get
# wrong: a key present means the real model, a key absent means the keyless
# fallback, and the choice is logged at startup.
#
#   OPENAI_API_KEY      absent -> embeddings come from a hashing vectoriser,
#                       which measures lexical overlap and NOT meaning. Good
#                       enough to build and test the pipeline against; it will
#                       not match a question phrased in words the source avoids.
#   ANTHROPIC_API_KEY   absent -> answers are extractive: verified sentences are
#                       quoted and attributed, never paraphrased, and the reply
#                       says that no model is configured.
#
# Required outside development — the config refuses to start without them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

HUMAN_REVIEW_THRESHOLD=0.5
MAX_CONTEXT_ITEMS=8
REQUEST_TIMEOUT_SECONDS=45
# Cosine similarity below which a vector hit is not a hit. Nearest-neighbour
# search always returns a nearest neighbour, so without a floor a question on an
# uncovered topic quotes whatever is least unlike it. Tune per embedding model.
RETRIEVAL_MIN_SIMILARITY=0.25
