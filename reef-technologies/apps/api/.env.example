# ════════════════════════════════════════════════════════════════════════════
#  Reef Technologies API — environment
#  Validated by @reef-technologies/config at boot. A bad value stops the process.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
APP_NAME=reef-technologies-api
LOG_LEVEL=debug
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Persistence ─────────────────────────────────────────────────────────────
# The APPLICATION role — unprivileged, and the one row-level security binds.
# Postgres bypasses RLS for a table's owner, so connecting the API as the owner
# would silently switch off every tenant isolation policy. That is the one
# failure mode the three-layer design exists to prevent, so the app never gets
# the owner's credentials.
DATABASE_URL=postgres://reef_technologies_app:reef_technologies_app@localhost:5432/reef_technologies
# The OWNER — used by `db:migrate` and `seed` only. Creating tables and policies
# requires it, and both run as one-shot jobs rather than inside the API.
MIGRATION_DATABASE_URL=postgres://reef_technologies:reef_technologies@localhost:5432/reef_technologies
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# ── Identity ────────────────────────────────────────────────────────────────
# 32+ chars. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-value-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# How long a just-rotated refresh token stays acceptable, so that parallel
# requests from one page load are not mistaken for a replay. This window is the
# one gap in reuse detection: keep it as small as the client's concurrency
# allows. Replays after it sign the account out everywhere.
AUTH_REFRESH_GRACE_SECONDS=5

# How long a password-reset link stays usable. Short: it is a bearer credential
# sitting in a mailbox the platform does not control and cannot revoke.
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
# Longer, because a confirmation link grants nothing on its own and the cost of
# an expired one is a resend.
AUTH_EMAIL_VERIFY_TTL_SECONDS=86400

# ── Outbound mail ───────────────────────────────────────────────────────────
# Where recovery links point. Built from here and never from the request Host,
# so a spoofed header cannot decide where a reset link sends the user.
APP_PUBLIC_URL=http://localhost:3000
# `log` prints the message to the server log and delivers nothing — fine for
# development, refused at boot in production. `http` posts
# { from, to, subject, html, text } with a bearer token, which is what the
# transactional providers accept as-is; it requires both variables below.
MAIL_TRANSPORT=log
MAIL_FROM=Reef Technologies <no-reply@reef-technologies.local>
# MAIL_HTTP_ENDPOINT=https://api.your-provider.example/emails
# MAIL_HTTP_TOKEN=

# ── Multi-tenancy ───────────────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=mauritius
TENANT_STRICT=true

# ── Event bus ───────────────────────────────────────────────────────────────
# memory = in-process (tests/local). redis = Redis Streams (required in prod).
EVENT_BUS_DRIVER=redis
EVENT_STREAM_PREFIX=reef_technologies:events
EVENT_CONSUMER_GROUP=reef-technologies-api

# ── AI worker ───────────────────────────────────────────────────────────────
AI_WORKER_BASE_URL=http://localhost:8000
AI_WORKER_TIMEOUT_MS=30000
AI_HUMAN_REVIEW_THRESHOLD=0.5

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BUCKET=reef-technologies-documents
STORAGE_REGION=eu-west-1

# ── Observability (optional) ────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# SENTRY_DSN=

# ════════════════════════════════════════════════════════════════════════════
#  MODULE FLAGS — one per module key. Absent = the registry default.
#  identity is always on; the rest can be switched off without a code change.
# ════════════════════════════════════════════════════════════════════════════
FEATURE_IDENTITY=true
FEATURE_ASSESSMENT=true
FEATURE_KNOWLEDGE=true
FEATURE_IMMIGRATION=true
FEATURE_AI_CONCIERGE=true
FEATURE_SAMPLE_FEATURE=true
FEATURE_RELOCATION=false
FEATURE_PROPERTY=false
FEATURE_FINANCE=false
FEATURE_MARKETPLACE=false
FEATURE_DOCUMENTS=false
FEATURE_ANALYTICS=false
FEATURE_BILLING=false

# ── Module-scoped config (required only when the module is enabled) ─────────
IDENTITY_PASSWORD_MIN_LENGTH=12
IDENTITY_ARGON_MEMORY_KIB=65536
ASSESSMENT_QUALIFIED_SCORE=60
ASSESSMENT_SESSION_TTL_HOURS=72
KNOWLEDGE_MIN_CONFIDENCE=0.7
KNOWLEDGE_SEARCH_LIMIT=8
KNOWLEDGE_VERIFICATION_TTL_DAYS=180
IMMIGRATION_MIN_CONFIDENCE=0.6
AI_CONCIERGE_MAX_CONTEXT_ITEMS=6
AI_CONCIERGE_MEMORY_LIMIT=20
AI_CONCIERGE_REQUEST_TIMEOUT_MS=45000
SAMPLE_FEATURE_PAGE_SIZE=25
SAMPLE_FEATURE_ALLOW_ANONYMOUS=false
