# Only NEXT_PUBLIC_* keys exist here — they are inlined into the browser
# bundle. Anything secret belongs in apps/api/.env, never in this file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_TENANT=mauritius
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Local-only feature overrides, comma-separated. The API's capability response
# still wins: this cannot turn on a feature the backend does not serve.
# NEXT_PUBLIC_FLAG_OVERRIDES=knowledge-explorer,ai-concierge
