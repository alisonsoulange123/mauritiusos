ENVIRONMENT=development
LOG_LEVEL=debug
PORT=8000

# Must match apps/api — both services share the database and the streams.
DATABASE_URL=postgres://anomalia:anomalia@localhost:5432/anomalia
REDIS_URL=redis://localhost:6379
EVENT_STREAM_PREFIX=anomalia:events
# A DIFFERENT group from the API's, so both receive every event.
EVENT_CONSUMER_GROUP=anomalia-ai-worker

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REASONING_MODEL=claude-opus-5
FAST_MODEL=claude-haiku-4-5-20251001

# Required outside development.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

HUMAN_REVIEW_THRESHOLD=0.5
MAX_CONTEXT_ITEMS=8
REQUEST_TIMEOUT_SECONDS=45
