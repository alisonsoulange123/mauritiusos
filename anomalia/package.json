{
  "name": "anomalia",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "node scripts/check-boundaries.mjs",
    "contracts:export": "pnpm --filter @anomalia/contracts export:schema",
    "db:generate": "pnpm --filter @anomalia/api db:generate",
    "db:migrate": "pnpm --filter @anomalia/api db:migrate",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "verify": "pnpm boundaries && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@anomalia/eslint-config": "workspace:*",
    "@anomalia/tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
